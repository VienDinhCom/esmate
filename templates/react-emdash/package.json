{
  "name": "react-emdash",
  "type": "module",
  "version": "0.0.3",
  "private": true,
  "emdash": {
    "label": "Starter",
    "seed": "seed/seed.json"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "esmate task dev",
    "build": "esmate task build",
    "preview": "esmate task preview",
    "start": "node ./dist/server/entry.mjs",
    "fix": "esmate task fix",
    "check": "esmate task check"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@astrojs/react": "^5.0.0",
    "astro": "^6.3.0",
    "better-sqlite3": "^12.8.0",
    "emdash": "^0.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@esmate/eslint": "^1.3.0",
    "@esmate/prettier": "^1.0.8",
    "@tailwindcss/vite": "^4.3.0",
    "eslint": "^10.4.0",
    "esmate": "^2.2.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "tasks": {
    "dev": "astro dev",
    "preview": "astro preview",
    "build": [
      "astro check",
      "astro build"
    ],
    "fix": [
      "esmate fmt",
      "esmate lint --fix"
    ],
    "check": [
      "astro check",
      "esmate fmt --check",
      "esmate lint"
    ]
  }
}
