{
  "name": "react-emdash",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Starter",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "esmate task dev",
    "build": "esmate task build",
    "preview": "esmate task preview",
    "start": "node ./dist/server/entry.mjs",
    "fix": "esmate task fix",
    "check": "esmate task check"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@astrojs/react": "^5.0.0",
    "astro": "^6.3.0",
    "better-sqlite3": "^12.8.0",
    "emdash": "^0.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@esmate/eslint": "^1.3.0",
    "@esmate/prettier": "^1.0.8",
    "eslint": "^10.4.0",
    "esmate": "^2.2.2",
    "prettier": "^3.8.3"
  },
  "tasks": {
    "dev": "astro dev",
    "preview": "astro preview",
    "build": [
      "astro check",
      "astro build"
    ],
    "fix": [
      "esmate fmt",
      "esmate lint --fix"
    ],
    "check": [
      "astro check",
      "esmate fmt --check",
      "esmate lint"
    ]
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
