---
import { decodeSlug, getEmDashEntry, getEntryTerms, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";

import Base from "@/components/layouts/base.astro";
import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";
import { resolveStarterSiteIdentity } from "@/lib/utils";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
  return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
  return Astro.redirect("/404");
}

if (Astro.cache?.enabled) 
Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
  siteTitle,
  siteUrl: Astro.url.origin,
  path: `/posts/${slug}`,
});

// Taxonomy terms for this post (use post.data.id, not post.id)
const tags = await getEntryTerms("posts", post.data.id, "tag");
const categories = await getEntryTerms("posts", post.data.id, "category");
---

<Base
  title={seo.title}
  pageTitle={seo.ogTitle}
  description={seo.description}
  canonical={seo.canonical}
  image={seo.ogImage}
  content={{ collection: "posts", id: post.data.id, slug }}
>
  <article class="prose max-w-none prose-neutral dark:prose-invert">
    {
      post.data.featured_image && (
        <div {...post.edit.featured_image} class="-mx-4 -mt-4 mb-6 overflow-hidden rounded-t-xl">
          <Image image={post.data.featured_image} />
        </div>
      )
    }

    <h1 class="not-prose mb-4 font-heading text-3xl font-semibold tracking-tight" {...post.edit.title}>
      {post.data.title}
    </h1>

    <div class="not-prose mb-6 flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
      {
        post.data.publishedAt && (
          <time datetime={post.data.publishedAt.toISOString()}>
            {post.data.publishedAt.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )
      }

      {
        categories.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {categories.map((c) => (
              <a href={`/category/${c.slug}`}>
                <Badge variant="outline">{c.label}</Badge>
              </a>
            ))}
          </div>
        )
      }
    </div>

    <PortableText value={post.data.content} />

    {
      tags.length > 0 && (
        <>
          <Separator className="not-prose my-8" />
          <div class="not-prose flex flex-wrap gap-2">
            {tags.map((t) => (
              <a href={`/tag/${t.slug}`}>
                <Badge variant="secondary">{t.label}</Badge>
              </a>
            ))}
          </div>
        </>
      )
    }
  </article>

  <aside class="mt-12">
    <WidgetArea name="sidebar" />
  </aside>
</Base>
